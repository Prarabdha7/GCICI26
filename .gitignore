# --- local-only sample content (never committed) ---
# Machine-local demo/seed/mock data lives here (see local/samples.example.json
# for the shape, which IS tracked). The repo ships zero baked-in samples;
# without demo_samples.json the app runs real-only and says so honestly.
/local/*
!/local/samples.example.json

# --- agent memory vault (generated, Obsidian-compatible) ---
# Rebuilt from live DB rows via GET /api/memory/vault. Open the folder in
# Obsidian for the interactive Graph View, or browse it in the /app console.
/vault/

