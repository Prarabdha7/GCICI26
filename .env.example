# ---------------------------------------------------------------------------
# JA Assure AI Marketing System — environment template
#
# Copy to .env and fill in.  NEVER commit .env — only this template is tracked.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- application ---------------------------------------------------------
ENVIRONMENT=dev                 # dev | demo | prod
DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000

# --- database ------------------------------------------------------------
# SQLite for development (default, zero setup):
DATABASE_URL=sqlite:///./ja_assure.db
# PostgreSQL for the demo — same code, just swap the URL:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ja_assure

# --- LLM provider --------------------------------------------------------
# Which provider the agents call: gemini | openai
LLM_PROVIDER=gemini

# Gemini (free tier via Google AI Studio — https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# OpenAI (only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Creative temperature for the content agent; the compliance judge is forced to 0.
LLM_TEMPERATURE=0.7

# --- state machine tuning ------------------------------------------------
# Circuit breaker: retry_count above this routes to the manual_intervention queue.
MAX_COMPLIANCE_RETRIES=3
# How many past human corrections to inject into the content prompt.
FEEDBACK_MEMORY_LIMIT=5

# --- demo mode (labeled simulations ONLY) ----------------------------------
# DEMO_MODE=true allows clearly-labeled demo writes (fallback copy, mock
# providers/publisher, stub reels, seed rows) so the pipeline can be shown
# without keys. Default false = real-only: unconfigured stages fail honestly
# instead of fabricating results. Demo rows are tagged is_demo / mock IDs and
# are excluded from real metrics. NEVER claim demo output as real.
DEMO_MODE=false

# Machine-local sample content for the demo path (gitignored local/ dir).
# The repo ships zero baked-in samples; without local/demo_samples.json the
# app runs real-only and says so honestly. See local/samples.example.json.
LOCAL_SAMPLES_PATH=local/demo_samples.json

# --- research / scraping (Phase 5) ---------------------------------------
# Live competitor/market research uses DuckDuckGo + Crawl4AI — no key needed.
SERPER_API_KEY=
SCRAPEGRAPH_API_KEY=
GOOGLE_PLACES_API_KEY=
HUNTER_API_KEY=

# --- publishing (Phase 7 — Project 2) ------------------------------------
# Buffer (GraphQL createPost) or Ayrshare. Only one is required.
BUFFER_ACCESS_TOKEN=
AYRSHARE_API_KEY=
# Public base URL the posting API can fetch generated media from.
PUBLIC_MEDIA_BASE_URL=
# Worker poll interval, seconds.
PUBLISH_POLL_INTERVAL=60
